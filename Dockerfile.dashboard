FROM python:3.12-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    google-cloud-bigquery>=3.25.0 \
    google-cloud-storage>=2.17.0 \
    google-genai>=1.0.0 \
    fastapi>=0.115.0 \
    uvicorn>=0.30.0 \
    jinja2>=3.1.0 \
    python-dotenv>=1.0.0 \
    httpx>=0.27.0 \
    aiofiles>=23.0.0 \
    twilio>=9.0.0 \
    python-multipart>=0.0.9 \
    pydub>=0.25.1 \
    "websockets>=12.0,<14.0"

COPY dashboard/        ./dashboard/
COPY outcome_processor/ ./outcome_processor/
COPY voice/            ./voice/
COPY assets/           ./assets/

ENV PORT=8080
ENV GCP_PROJECT=butterfly-987
ENV BQ_DATASET=wealth_mgmt_demo

EXPOSE 8080
CMD ["sh", "-c", "uvicorn dashboard.server:app --host 0.0.0.0 --port ${PORT:-8080}"]
