# SBI MF Outbound Agent — Environment Variables
# Copy to .env and fill in your values.

# ── GCP ──────────────────────────────────────────────────────────────
GCP_PROJECT=your-project
GCP_REGION=asia-south1
GCP_LOCATION=global
BQ_DATASET=sbi_mf_poc

# ── Gemini ───────────────────────────────────────────────────────────
# Option A: Google AI Studio API key (simplest for PoC)
GOOGLE_API_KEY=

# Option B: Vertex AI (set GCP_PROJECT above, leave GOOGLE_API_KEY empty)
# Gemini Live model — use the exact model ID from agentic-rm-banking
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview-04-2026

# ── Twilio ───────────────────────────────────────────────────────────
# Get from https://console.twilio.com/
# Trial account: $15.50 credit ≈ 50 outbound calls to India
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=          # verified Twilio number e.g. +12025551234
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886  # sandbox number

# ── GCS buckets ──────────────────────────────────────────────────────
GCS_BUCKET=sbi-mf-voice-notes
TRANSCRIPT_BUCKET=sbi-mf-call-transcripts

# ── Service URLs (local dev) ─────────────────────────────────────────
VOICE_MCP_URL=http://localhost:8005
LIVEAPI_BROKER_URL=http://localhost:8010

# ── Demo settings ────────────────────────────────────────────────────
# Mobile number to call in demo (must be Twilio-verified for trial accounts)
DEMO_MOBILE=+91XXXXXXXXXX
